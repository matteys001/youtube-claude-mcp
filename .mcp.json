{
  "mcpServers": {
    "creatoros": {
      "command": "python",
      "args": ["${CLAUDE_PLUGIN_ROOT}/launch.py"],
      "env": {
        "CREATOROS_GOOGLE_CLIENT_ID": "${user_config.google_client_id}",
        "CREATOROS_GOOGLE_CLIENT_SECRET": "${user_config.google_client_secret}",
        "CREATOROS_API_KEY": "${user_config.youtube_api_key}"
      }
    }
  }
}
